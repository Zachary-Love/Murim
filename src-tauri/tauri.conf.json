{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Murim",
  "version": "0.3.11",
  "identifier": "dev.murim.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Murim", "width": 1100, "height": 720, "titleBarStyle": "Overlay", "hiddenTitle": true, "trafficLightPosition": { "x": 14, "y": 16 } }],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' ws: http://localhost:1420 ipc: http://ipc.localhost; img-src 'self' data: https:"
    }
  },
  "bundle": { "active": true, "createUpdaterArtifacts": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"] },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyQUNDMDk2MEZBNzg0N0MKUldSOGhLY1Bsc0NzNHBaT0FPTmN4eHErYmVMbnFzaVViczFGdzlNdXZrVk5XYjJHaEhVSVgzWkUK",
      "endpoints": ["https://github.com/Zachary-Love/Murim/releases/latest/download/latest.json"]
    }
  }
}
